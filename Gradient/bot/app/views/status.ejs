<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simplebot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-<%= bgcolor %>">
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card p-3">
          <div class="card-body">
            <h5 class="card-title text-center">Current status of your submission</h5>
            <hr />
            <div class="row mb-2">
                <div class="col-md-3">
                    <p class="text-center fw-bold">Submission ID</p>
                </div>
                <div class="col-md-9">
                    <p><%= sess_key %></p>
                </div>
            </div>
            <% if (sess.url) { %> 
            <div class="row mb-2">
                <div class="col-md-3">
                    <p class="text-center fw-bold">Submitted URL</p>
                </div>
                <div class="col-md-9">
                    <%= sess.url %>
                </div>
            </div>
            <% } %>
            <div class="row mb-2">
                <div class="col-md-3">
                    <p class="text-center fw-bold">Status</p>
                </div>
                <div class="col-md-9">
                    <%= status_str %>
                </div>
            </div>
            <% if (sess.status == 3 && sess.error) { %> 
            <div class="row mb-2">
                <div class="col-md-3">
                    <p class="text-center fw-bold">Error Detail</p>
                </div>
                <div class="col-md-9">
                    <%= sess.error %>
                </div>
            </div>
            <% } %>
            <% if (sess.status >= 2) { %> 
            <div class="row mb-2">
                <div class="col-md-3">
                    <p class="text-center fw-bold">Finished at</p>
                </div>
                <div class="col-md-9">
                    <%= sess.done_at %>
                </div>
            </div>
            <% } %>
            
            <div class="text-center">
                <a class="btn btn-sm btn-primary" href="/">Return to main page</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>